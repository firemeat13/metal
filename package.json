{
  "name": "metaldiscographyapp",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@types/react": "^19.3.0",
    "@types/react-native": "^0.72.8",
    "electron-is-dev": "^3.0.1",
    "expo": "~58.0.14",
    "expo-splash-screen": "^58.0.10",
    "expo-status-bar": "~58.0.3",
    "firebase": "^13.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "typescript": "^7.0.2",
    "zustand": "^5.0.15"
  },
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "electron-dev": "concurrently \"npm run web\" \"wait-on http://localhost:19006 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "build": "expo export --platform web"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^8.2.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.metaldiscography.app",
    "productName": "Metal Discography",
    "files": [
      "build/**/*",
      "public/electron.js"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
